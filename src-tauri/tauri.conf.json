{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen Media Player",
  "version": "2.0.0",
  "identifier": "com.lumen.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumen Media Player",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400,
        "transparent": true,
        "decorations": true,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["mp4", "mkv", "avi", "mov", "webm", "flv", "wmv", "m4v", "ts", "m2ts", "mp3", "flac", "wav", "aac", "ogg", "m4a", "opus"],
        "name": "Lumen Media File",
        "role": "Viewer"
      }
    ]
  }
}
